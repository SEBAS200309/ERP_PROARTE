@startuml ERP_ProArte_ClassDiagram
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam nodesep 60
skinparam ranksep 50

title Diagrama de Clases UML - Backend Spring Boot - ERP Pro Arte

package "common" #F0F0F0 {
  class ApiResponse<T> {
    - success : boolean
    - data : T
    - message : String
    + {static} ok(data, msg) : ApiResponse
    + {static} error(code, msg) : ApiResponse
  }

  class ProcedureExecutor {
    - jdbcTemplate : JdbcTemplate
    + executeFunction(name, params) : Map
    + executeProcedure(name, params) : void
  }

  class GlobalExceptionHandler <<@RestControllerAdvice>> {
    + handleNotFound(ex) : ApiResponse
    + handleBusiness(ex) : ApiResponse
    + handleValidation(ex) : ApiResponse
  }
}

package "auth" #E6D6FF {
  class AuthController <<@RestController>> {
    + login(request) : ApiResponse
    + logout() : ApiResponse
    + refreshToken(request) : ApiResponse
  }

  class AuthService <<@Service>> {
    - usuarioRepository : UsuarioRepository
    - passwordEncoder : PasswordEncoder
    - jwtUtil : JwtUtil
    + authenticate(username, password) : TokenResponse
    + refresh(refreshToken) : TokenResponse
  }
}

package "usuario" #E6E6FF {
  class Usuario <<@Entity>> {
    - id : UUID
    - username : String
    - passwordHash : String
    - nombreCompleto : String
    - email : String
    - rol : Rol
    - activo : boolean
    - createdAt : LocalDateTime
  }

  class Rol <<@Entity>> {
    - id : UUID
    - nombre : String
    - descripcion : String
    - permisos : List<Permiso>
    - activo : boolean
  }

  class Permiso <<@Entity>> {
    - id : UUID
    - configuracion : Map<String, Object>
    - activo : boolean
  }

  class UsuarioController <<@RestController>> {
    + listar(filtros) : ApiResponse
    + crear(request) : ApiResponse
    + actualizar(id, request) : ApiResponse
    + eliminar(id) : ApiResponse
    + consultarPermisos(rolId) : ApiResponse
    + actualizarPermisos(rolId, configJson) : ApiResponse
  }

  class UsuarioService <<@Service>> {
    - repository : UsuarioRepository
    - permisoRepository : PermisoRepository
    + listar(filtros) : Page<Usuario>
    + crear(dto) : Usuario
    + actualizar(id, dto) : Usuario
    + eliminar(id) : void
    + consultarPermisos(rolId) : Permiso
    + actualizarPermisos(rolId, configJson) : void
  }

  interface UsuarioRepository <<@Repository>> {
    + findByUsername(username) : Optional<Usuario>
    + findAllByActivoTrue(pageable) : Page<Usuario>
  }

  Rol "1" *-- "*" Permiso
  Rol "1" -- "*" Usuario
  UsuarioController --> UsuarioService
  UsuarioService --> UsuarioRepository
}

package "persona" #FFF5E6 {
  class Persona <<@Entity>> {
    - id : UUID
    - nombres : String
    - apellidos : String
    - tipoDocumento : String
    - documento : String
    - telefono : String
    - email : String
    - rolPersona : String
    - activo : boolean
    - createdBy : UUID
  }

  class PersonaController <<@RestController>> {
    + listar(filtros) : ApiResponse
    + crear(request) : ApiResponse
    + actualizar(id, request) : ApiResponse
    + eliminar(id) : ApiResponse
    + asociarEmpresa(id, empresaId) : ApiResponse
    + asignarRol(id, rol) : ApiResponse
  }

  class PersonaService <<@Service>> {
    - repository : PersonaRepository
    + listar(filtros) : Page<Persona>
    + crear(dto) : Persona
    + actualizar(id, dto) : Persona
    + eliminar(id) : void
    + asociarEmpresa(personaId, empresaId, cargo) : void
    + asignarRol(id, rol) : void
  }

  interface PersonaRepository <<@Repository>> {
    + findAllByActivoTrue(pageable) : Page<Persona>
  }

  PersonaController --> PersonaService
  PersonaService --> PersonaRepository
}

