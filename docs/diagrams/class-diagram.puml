    - fecha : LocalDateTime
    - createdBy : UUID
  }

  class EventoInsumo <<@Entity>> {
    - id : UUID
    - evento : Evento
    - insumo : Insumo
    - cantidad : BigDecimal
  }

  class EventoAlimentacion <<@Entity>> {
    - id : UUID
    - evento : Evento
    - descripcion : String
    - cantidad : BigDecimal
    - tipoMovimiento : String
    - fecha : LocalDateTime
    - createdBy : UUID
  }

  class EventoController <<@RestController>> {
    + listar(filtros) : ApiResponse
    + crearDesdeCotizacion(cotizacionId) : ApiResponse
    + asociarProveedor(id, request) : ApiResponse
    + asociarContacto(id, request) : ApiResponse
    + gestionarPersonal(id, request) : ApiResponse
    + calcularTurno(id, personalId) : ApiResponse
    + gestionarObservaciones(id) : ApiResponse
    + gestionarInsumos(id, request) : ApiResponse
    + registrarIngresoAlimentacion(id, request) : ApiResponse
    + registrarRetiroAlimentacion(id, request) : ApiResponse
    + consultarDisponibilidadAlimentacion(id) : ApiResponse
