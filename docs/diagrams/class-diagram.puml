' =========================================================
' RELACIONES ENTRE PACKAGES
' =========================================================

AuthService -[#6B3FA0]-> UsuarioRepository

' Proveedor puede originarse de una persona o de una empresa
Persona "0..1" -[#28B463]- "*" Proveedor
Empresa "0..1" -[#28B463]- "*" Proveedor

' Corregido: una cotización puede generar VARIOS eventos
' (el ERD no restringe unicidad en evento.cotizacion_id),
' antes decía por error "0..1"
Cotizacion "1" -[#C0392B]- "*" Evento

' Insumos consumidos por evento (antes no existía ningún vínculo)
Insumo "1" -[#C0392B]- "*" EventoInsumo

' Una solicitud de servicio puede derivar en una orden de compra
SolicitudServicio "1" -[#7D3C98]- "*" OrdenCompra

' Una presentación documenta un servicio
Servicio "0..1" -[#AD1457]- "*" Presentacion

' Descuentos/recargos aplicables a Servicio, Persona y Empresa.
' A diferencia de PersonaEmpresa, estas tablas puente
' (servicio_descuento_recargo, persona_descuento_recargo,
' empresa_descuento_recargo) NO tienen atributos propios en el
' ERD, por eso se representan como asociación N:M directa y no
' como clases de asociación.
Servicio "*" -[#F39C12]- "*" DescuentoRecargo
Persona  "*" -[#F39C12]- "*" DescuentoRecargo
Empresa  "*" -[#F39C12]- "*" DescuentoRecargo

@enduml