package "lead" #FFFFE6 {
  class Lead <<@Entity>> {
    - id : UUID
    - descripcion : String
    - estado : String
    - persona : Persona
    - empresa : Empresa
    - activo : boolean
    - createdBy : UUID
  }

  class LeadController <<@RestController>> {
    + listar(filtros) : ApiResponse
    + crear(request) : ApiResponse
    + actualizar(id, request) : ApiResponse
    + eliminar(id) : ApiResponse
    + estadisticas() : ApiResponse
  }

  class LeadService <<@Service>> {
    - repository : LeadRepository
    - procedureExecutor : ProcedureExecutor
    + listar(filtros) : Page<Lead>
    + crear(dto) : Lead
    + estadisticas() : Map
  }

  LeadController --> LeadService
  LeadService --> ProcedureExecutor
}

package "proveedor" #E6F0FF {
  class Proveedor <<@Entity>> {
    - id : UUID
    - persona : Persona
    - empresa : Empresa
    - especialidad : String
    - activo : boolean
  }

  class Portafolio <<@Entity>> {
    - id : UUID
    - proveedor : Proveedor
    - servicio : Servicio
    - precioUnitario : BigDecimal
    - activo : boolean
  }

  class SolicitudServicio <<@Entity>> {
    - id : UUID
    - proveedor : Proveedor
    - servicio : Servicio
    - evento : Evento
    - estado : String
    - activo : boolean
  }

  class ProveedorController <<@RestController>> {
    + listar(filtros) : ApiResponse
    + crear(request) : ApiResponse
    + actualizar(id, request) : ApiResponse
    + eliminar(id) : ApiResponse
    + gestionarPortafolio(id) : ApiResponse
    + gestionarSolicitudes(id) : ApiResponse
  }

  class ProveedorService <<@Service>> {
    - proveedorRepo : ProveedorRepository
    - portafolioRepo : PortafolioRepository
    - solicitudRepo : SolicitudRepository
    + listar(filtros) : Page<Proveedor>
    + crear(dto) : Proveedor
    + crearPortafolio(provId, dto) : Portafolio
    + crearSolicitud(provId, dto) : SolicitudServicio
  }

  Proveedor "1" *-- "*" Portafolio
  Proveedor "1" *-- "*" SolicitudServicio
  ProveedorController --> ProveedorService
}

package "servicio" #E6FFE6 {
  class Servicio <<@Entity>> {
    - id : UUID
    - nombre : String
    - descripcion : String
    - categoria : String
    - esPropio : boolean
    - requiereOc : boolean
    - servicioPadre : Servicio
    - activo : boolean
  }

  class TipoDescuentoRecargo <<@Entity>> {
    - id : UUID
    - nombre : String
  }

  class DescuentoRecargo <<@Entity>> {
    - id : UUID
    - nombre : String
    - valor : BigDecimal
    - tipo : TipoDescuentoRecargo
    - activo : boolean
  }

  class ServicioController <<@RestController>> {
    + listar(filtros) : ApiResponse
    + crear(request) : ApiResponse
    + actualizar(id, request) : ApiResponse
    + eliminar(id) : ApiResponse
    + gestionarSubservicios(id) : ApiResponse
  }

  class ServicioService <<@Service>> {
    - servicioRepo : ServicioRepository
    - drRepo : DescuentoRecargoRepository
    + listar(filtros) : Page<Servicio>
    + crear(dto) : Servicio
    + asignarSubservicio(padreId, hijoId) : void
    + crearDescuentoRecargo(dto) : DescuentoRecargo
  }

  class DescuentoRecargoController <<@RestController>> {
    + listar() : ApiResponse
    + crear(request) : ApiResponse
    + actualizar(id, request) : ApiResponse
    + eliminar(id) : ApiResponse
    + aplicar(targetType, targetId, drId) : ApiResponse
  }

  class DescuentoRecargoService <<@Service>> {
    - repository : DescuentoRecargoRepository
    + listar() : List<DescuentoRecargo>
    + crear(dto) : DescuentoRecargo
    + aplicarAServicio(servicioId, drId) : void
    + aplicarAPersona(personaId, drId) : void
    + aplicarAEmpresa(empresaId, drId) : void
  }

  TipoDescuentoRecargo "1" -- "*" DescuentoRecargo
  Servicio "0..1" -- "*" Servicio : padre
  ServicioController --> ServicioService
  DescuentoRecargoController --> DescuentoRecargoService
}

package "cotizacion" #FFF0E6 {
  class Cotizacion <<@Entity>> {
    - id : UUID
    - codigo : String
    - estado : String
    - fechaCreacion : LocalDateTime
    - fechaVencimiento : LocalDate
    - total : BigDecimal
    - persona : Persona
    - empresa : Empresa
    - items : List<CotizacionItem>
    - activo : boolean
    - createdBy : UUID
  }

  class CotizacionItem <<@Entity>> {
    - id : UUID
    - cotizacion : Cotizacion
    - servicio : Servicio
    - cantidad : Integer
    - precioUnitario : BigDecimal
    - descuentoRecargo : DescuentoRecargo
    - subtotal : BigDecimal
  }

  class CotizacionController <<@RestController>> {
    + listar(filtros) : ApiResponse
    + crear(request) : ApiResponse
    + actualizar(id, request) : ApiResponse
    + eliminar(id) : ApiResponse
    + cambiarEstado(id, estado) : ApiResponse
    + proximasAVencer(dias) : ApiResponse
    + generarPdf(id) : byte[]
    + recalcularTotal(id) : ApiResponse
  }

  class CotizacionService <<@Service>> {
    - repository : CotizacionRepository
    - procedureExecutor : ProcedureExecutor
    + listar(filtros) : Page<Cotizacion>
    + crear(dto) : Cotizacion
    + cambiarEstado(id, estado) : void
    + proximasAVencer(dias) : List<Cotizacion>
    + recalcularTotal(id) : BigDecimal
    + generarPdf(id) : byte[]
  }

  Cotizacion "1" *-- "*" CotizacionItem
  CotizacionController --> CotizacionService
  CotizacionService --> ProcedureExecutor
}

package "evento" #FFE6E6 {
  class Evento <<@Entity>> {
    - id : UUID
    - cotizacion : Cotizacion
    - nombre : String
    - fechaInicio : LocalDateTime
    - fechaFin : LocalDateTime
    - lugar : String
    - estado : String
    - activo : boolean
    - createdBy : UUID
  }

  class EventoContacto <<@Entity>> {
    - id : UUID
    - evento : Evento
    - persona : Persona
    - rolEvento : String
    - observaciones : String
  }

  class EventoPersonal <<@Entity>> {
    - id : UUID
    - evento : Evento
    - persona : Persona
    - proveedor : Proveedor
    - servicio : Servicio
    - valorTurno : BigDecimal
    - tieneArl : boolean
    - tieneOp : boolean
    - observaciones : String
  }

  class EventoController <<@RestController>> {
    + listar(filtros) : ApiResponse
    + crearDesdeCotizacion(cotizacionId) : ApiResponse
    + asociarProveedor(id, request) : ApiResponse
    + asociarContacto(id, request) : ApiResponse
    + gestionarPersonal(id, request) : ApiResponse
    + calcularTurno(id, personalId) : ApiResponse
    + gestionarObservaciones(id) : ApiResponse
  }

  class EventoService <<@Service>> {
    - eventoRepo : EventoRepository
    - procedureExecutor : ProcedureExecutor
    + listar(filtros) : Page<Evento>
    + crearDesdeCotizacion(cotizacionId) : Evento
    + asociarContacto(eventoId, dto) : EventoContacto
    + gestionarPersonal(eventoId, dto) : EventoPersonal
    + calcularTurno(eventoId, personalId) : BigDecimal
  }

  Evento "1" *-- "*" EventoContacto
  Evento "1" *-- "*" EventoPersonal
  EventoController --> EventoService
  EventoService --> ProcedureExecutor
}

package "inventario" #E6FFF0 {
  class Insumo <<@Entity>> {
    - id : UUID
    - nombre : String
    - descripcion : String
    - unidadMedida : String
    - stockActual : BigDecimal
    - activo : boolean
  }

  class InsumoMovimiento <<@Entity>> {
    - id : UUID
    - insumo : Insumo
    - tipoMovimiento : String
    - cantidad : BigDecimal
    - fecha : LocalDateTime
    - motivo : String
    - createdBy : UUID
  }

  class InventarioController <<@RestController>> {
    + consultarStock() : ApiResponse
    + registrarIngreso(request) : ApiResponse
    + registrarRetiro(request) : ApiResponse
    + historialIngresos(insumoId) : ApiResponse
    + historialRetiros(insumoId) : ApiResponse
  }

  class InventarioService <<@Service>> {
    - insumoRepo : InsumoRepository
    - movimientoRepo : InsumoMovimientoRepository
    + consultarStock() : List<Insumo>
    + registrarIngreso(dto) : InsumoMovimiento
    + registrarRetiro(dto) : InsumoMovimiento
  }

  Insumo "1" *-- "*" InsumoMovimiento
  InventarioController --> InventarioService
}

