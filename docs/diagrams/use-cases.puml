@startuml ERP_ProArte_UseCases

left to right direction
skinparam actorStyle awesome
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam nodesep 20
skinparam ranksep 30

title Diagrama de Casos de Uso - ERP Pro Arte

legend right
  |= Color |= Actor |
  | <#663399> | Administrador |
  | <#DAA520> | Comercial |
  | <#CC5500> | Operativo |
  | <#CC0000> | Coordinador |
endlegend

' =========================================================
' ACTORES
' =========================================================
' Se agrega un actor abstracto "Usuario del Sistema" que
' generaliza a los cuatro roles concretos. Así, "Iniciar
' sesión" y "Cerrar sesión" solo se asocian una vez con el
' actor abstracto, en lugar de repetirse en cada rol
' (generalización de actores, patrón recomendado en UML).

actor "Administrador"     as admin       #663399
actor "Comercial"         as comercial   #DAA520
actor "Operativo"         as operativo   #CC5500
actor "Coordinador"       as coordinador #CC0000
actor "Usuario del Sistema" as usuario

admin       --|> usuario
comercial   --|> usuario
operativo   --|> usuario
coordinador --|> usuario


' =========================================================
' SISTEMA
' =========================================================

rectangle "Sistema ERP Pro Arte" {

    ' =====================================================
    ' SEGURIDAD
    ' =====================================================

    rectangle "Seguridad y acceso" {
        usecase "Iniciar sesión" as UC_LOGIN
        usecase "Cerrar sesión" as UC_LOGOUT
    }

    usuario --> UC_LOGIN
    usuario --> UC_LOGOUT


    ' =====================================================
    ' ADMINISTRACIÓN
    ' =====================================================

    rectangle "Administración del sistema" {
        usecase "Gestionar usuarios" as UC_USERS
        usecase "Gestionar permisos" as UC_PERMISOS
        usecase "Consultar matriz de permisos" as UC_MATRIX
    }

    ' Consultar la matriz es una vista opcional adicional
    ' sobre la gestión de permisos -> extend
    UC_MATRIX ..> UC_PERMISOS : <<extend>>


    ' =====================================================
    ' GESTIÓN COMERCIAL
    ' =====================================================

    rectangle "Gestión Comercial (CRM)" {
        usecase "Gestionar leads" as UC_LEADS
        usecase "Consultar estadísticas de leads" as UC_GRAF_LEADS

        usecase "Gestionar personas" as UC_PERSONAS
        usecase "Gestionar empresas" as UC_EMPRESAS
        usecase "Asociar personas y empresas" as UC_ASOC_PE
        usecase "Asignar roles comerciales" as UC_ROLES
    }

    UC_GRAF_LEADS ..> UC_LEADS : <<extend>>


    ' =====================================================
    ' CATÁLOGO
    ' =====================================================

    rectangle "Catálogo de servicios" {
        usecase "Gestionar servicios" as UC_SERVICIOS
        usecase "Gestionar subservicios" as UC_SUBSERV
        usecase "Gestionar descuentos y recargos" as UC_DR
    }


    ' =====================================================
    ' COTIZACIONES
    ' =====================================================

    rectangle "Cotizaciones" {
        usecase "Gestionar cotizaciones" as UC_COTIZ
        usecase "Gestionar estados de cotización" as UC_ESTADOS_COT
        usecase "Consultar cotizaciones próximas a vencer" as UC_VENCER
        usecase "Asociar cliente y contacto" as UC_ASOC_CLI
        usecase "Generar cotización en PDF" as UC_PDF_COT
    }

    ' Toda cotización requiere obligatoriamente asociar
    ' cliente y contacto -> include
    UC_COTIZ ..> UC_ASOC_CLI : <<include>>
    ' Generar el PDF y consultar próximas a vencer son
    ' funciones opcionales sobre la cotización -> extend
    UC_PDF_COT ..> UC_COTIZ : <<extend>>
    UC_VENCER  ..> UC_COTIZ : <<extend>>


    ' =====================================================
    ' PROVEEDORES
    ' =====================================================

    rectangle "Proveedores y servicios tercerizados" {
        usecase "Gestionar proveedores" as UC_PROVEEDORES
        usecase "Gestionar portafolios" as UC_PORTAFOLIOS
        usecase "Gestionar solicitudes de servicio" as UC_SOLICITUDES
    }


    ' =====================================================
    ' EVENTOS
    ' =====================================================

    rectangle "Gestión de eventos" {
        usecase "Crear evento desde cotización aprobada" as UC_CREAR_EVT
        usecase "Gestionar proveedores del evento" as UC_ASOC_PROV
        usecase "Gestionar servicios del evento" as UC_ASOC_SERV
        usecase "Gestionar contactos y roles" as UC_ASOC_CONT
        usecase "Gestionar observaciones" as UC_OBS
    }

    ' Crear el evento exige siempre verificar que la
    ' cotización esté en estado "aprobada" -> include
    UC_CREAR_EVT ..> UC_ESTADOS_COT : <<include>>


    ' =====================================================
    ' PERSONAL
    ' =====================================================

    rectangle "Personal de evento" {
        usecase "Gestionar personal del evento" as UC_PERSONAL
        usecase "Calcular valor del turno" as UC_TURNO
        usecase "Verificar ARL y OP" as UC_ARL
    }

    ' Gestionar personal implica obligatoriamente calcular
    ' el turno y verificar ARL/OP -> include
    UC_PERSONAL ..> UC_TURNO : <<include>>
    UC_PERSONAL ..> UC_ARL   : <<include>>


    ' =====================================================
    ' ORDENES DE COMPRA
    ' =====================================================

    rectangle "Órdenes de compra" {
        usecase "Gestionar órdenes de compra" as UC_ORDENES
        usecase "Generar órdenes de compra en Excel" as UC_EXCEL_OC
    }

    UC_EXCEL_OC ..> UC_ORDENES : <<extend>>


    ' =====================================================
    ' COMUNICACIONES
    ' =====================================================

    rectangle "Comunicaciones y documentos" {
        usecase "Gestionar mensajes y plantillas" as UC_MENSAJES
        usecase "Generar documentos PDF" as UC_PDF
        usecase "Descargar información de proveedores en Excel" as UC_EXCEL_PROV
    }

    UC_PDF        ..> UC_MENSAJES    : <<extend>>
    UC_EXCEL_PROV ..> UC_PROVEEDORES : <<extend>>


    ' =====================================================
    ' PRESENTACIONES
    ' =====================================================

    rectangle "Presentaciones" {
        usecase "Gestionar presentaciones" as UC_PRESENT
        usecase "Generar presentación en PDF" as UC_PDF_PRES
    }

    UC_PDF_PRES ..> UC_PRESENT : <<extend>>


    ' =====================================================
    ' INVENTARIO
    ' =====================================================

    rectangle "Inventario" {
        usecase "Registrar ingresos de inventario" as UC_ING_INV
        usecase "Registrar retiros de inventario" as UC_RET_INV
        usecase "Consultar existencias" as UC_STOCK
        usecase "Consultar movimientos de inventario" as UC_MOV_INV
    }

    ' Todo ingreso o retiro genera obligatoriamente un
    ' movimiento de inventario -> include
    UC_ING_INV ..> UC_MOV_INV : <<include>>
    UC_RET_INV ..> UC_MOV_INV : <<include>>


    ' =====================================================
    ' ALIMENTACIÓN
    ' =====================================================

    rectangle "Alimentación de eventos" {
        usecase "Registrar ingresos de alimentación" as UC_ING_ALIM
        usecase "Registrar retiros de alimentación" as UC_RET_ALIM
        usecase "Consultar disponibilidad de alimentación" as UC_DISP_ALIM
    }


    ' =====================================================
    ' CONSULTAS
    ' =====================================================

    rectangle "Consultas operativas" {
        usecase "Consultar eventos asignados" as UC_CONS_EVT
        usecase "Consultar personal" as UC_CONS_PERS
        usecase "Consultar observaciones" as UC_CONS_OBS
    }
}


' =========================================================
' ASOCIACIONES ACTOR - CASO DE USO
' =========================================================

' ---------------------------------------------------------
' ADMINISTRADOR
' ---------------------------------------------------------
admin -[#663399]-> UC_USERS
admin -[#663399]-> UC_PERMISOS
admin -[#663399]-> UC_MATRIX


' ---------------------------------------------------------
' COMERCIAL
' ---------------------------------------------------------
comercial -[#DAA520]-> UC_LEADS
comercial -[#DAA520]-> UC_GRAF_LEADS

comercial -[#DAA520]-> UC_PERSONAS
comercial -[#DAA520]-> UC_EMPRESAS
comercial -[#DAA520]-> UC_ASOC_PE
comercial -[#DAA520]-> UC_ROLES

comercial -[#DAA520]-> UC_SERVICIOS
comercial -[#DAA520]-> UC_SUBSERV
comercial -[#DAA520]-> UC_DR

comercial -[#DAA520]-> UC_COTIZ
comercial -[#DAA520]-> UC_ESTADOS_COT
comercial -[#DAA520]-> UC_VENCER
comercial -[#DAA520]-> UC_ASOC_CLI
comercial -[#DAA520]-> UC_PDF_COT

comercial -[#DAA520]-> UC_MENSAJES
comercial -[#DAA520]-> UC_PDF
comercial -[#DAA520]-> UC_EXCEL_PROV

comercial -[#DAA520]-> UC_PRESENT
comercial -[#DAA520]-> UC_PDF_PRES


' ---------------------------------------------------------
' OPERATIVO
' ---------------------------------------------------------
operativo -[#CC5500]-> UC_PROVEEDORES
operativo -[#CC5500]-> UC_PORTAFOLIOS
operativo -[#CC5500]-> UC_SOLICITUDES

operativo -[#CC5500]-> UC_CREAR_EVT
operativo -[#CC5500]-> UC_ASOC_PROV
operativo -[#CC5500]-> UC_ASOC_SERV
operativo -[#CC5500]-> UC_ASOC_CONT
operativo -[#CC5500]-> UC_OBS

operativo -[#CC5500]-> UC_PERSONAL
operativo -[#CC5500]-> UC_TURNO
operativo -[#CC5500]-> UC_ARL

operativo -[#CC5500]-> UC_ORDENES
operativo -[#CC5500]-> UC_EXCEL_OC

operativo -[#CC5500]-> UC_ING_INV
operativo -[#CC5500]-> UC_RET_INV
operativo -[#CC5500]-> UC_STOCK
operativo -[#CC5500]-> UC_MOV_INV

operativo -[#CC5500]-> UC_ING_ALIM
operativo -[#CC5500]-> UC_RET_ALIM
operativo -[#CC5500]-> UC_DISP_ALIM


' ---------------------------------------------------------
' COORDINADOR
' ---------------------------------------------------------
coordinador -[#CC0000]-> UC_CONS_EVT
coordinador -[#CC0000]-> UC_CONS_PERS
coordinador -[#CC0000]-> UC_CONS_OBS

@enduml